# Discord user token (raw, no "Bot " prefix). Treat it like a password:
# it is full account access, not a scoped bot token.
DISCORD_TOKEN=

# guildID:owner/repo, comma separated — keep it on ONE line, docker compose
# does not support line continuations in env_file.
# A guild that is not listed is ignored completely: no rows, no page.
# Add #history to append normal commits instead of rewriting the branch to a
# single commit (use it for a repo with history worth keeping).
GUILD_REPOS=1124533898764890132:rpfilomeno/tps,1476488183075307541:rpfilomeno/chieko-discord-stats,956930938682617956:rpfilomeno/tapsi-discord-stats,956942809984806933:rpfilomeno/lomi-discord-stats

# Fine-grained PAT: Contents read/write on those repos. Nothing else needed.
GITHUB_TOKEN=
GITHUB_BRANCH=main
# "" = repo root, "docs" = publish into /docs
PAGES_PATH=

DATA_DIR=/data
TZ=Asia/Seoul
STATS_INTERVAL=6h
TOP_N=25
INCLUDE_BOTS=false
LOG_LEVEL=info

# Account presence, applied at connect. Everything here is optional.
# STATUS: online | idle | dnd | invisible
STATUS=online
# Custom status text (max 128 chars) and an optional unicode emoji.
CUSTOM_STATUS=
CUSTOM_STATUS_EMOJI=
# Rich presence: leave RPC_NAME empty to disable it.
# RPC_TYPE: playing | listening | watching | competing
RPC_NAME=
RPC_TYPE=playing
RPC_DETAILS=
RPC_STATE=
# RPC_IMAGE is an asset key of the RPC_APP_ID app, or a direct URL.
RPC_IMAGE=
RPC_IMAGE_TEXT=
# Minutes already elapsed on the activity timer (0 = none).
RPC_START_MIN=0
RPC_APP_ID=
